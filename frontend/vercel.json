{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://agentescrow402-api.onrender.com/:path*" },
    { "source": "/((?!assets|images|robots.txt|sitemap.xml|api).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]}
  ]
}
