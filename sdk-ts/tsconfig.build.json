{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true
  },
  "include": [
    "index.ts",
    "client.ts",
    "errors.ts",
    "types.ts",
    "verify.ts",
    "webhooks.ts"
  ],
  "exclude": [
    "*.test.ts",
    "dist",
    "node_modules"
  ]
}
