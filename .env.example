# AgentEscrow402 Configuration
# Copy this file to .env and fill in the values

# Casper Network
CASPER_NODE_URL=https://node.testnet.cspr.cloud/rpc
CASPER_CHAIN_NAME=casper-test
DEPLOYER_SECRET_KEY_PATH=./keys/secret_key.pem

# Server
HOST=0.0.0.0
PORT=8000
SANDBOX_MODE=true

# Escrow defaults
DEFAULT_TTL=300
INSURANCE_FEE_BPS=200
MIN_ESCROW_AMOUNT=100000

# Reputation
REPUTATION_DECAY=0.95
INITIAL_REPUTATION=50

# Contract (set after testnet deploy)
ESCROW_CONTRACT_HASH=
# Optional overrides — default to the currently deployed testnet addresses,
# only needed if you redeploy one of these independently of Core Escrow.
MANAGER_CONTRACT_HASH=
INSURANCE_CONTRACT_HASH=
VRF_CONTRACT_HASH=

# Arbiter multisig (resolve() dispute settlement)
# Comma-separated hex Ed25519 pubkeys of the 5 registered arbiters (tag-prefixed
# "01" + 32-byte hex), matching the on-chain `arbiter_list` set via
# server/casper_tx/set_arbiters.mjs. When set, the /resolve endpoint verifies
# each submitted (pubkey, signature) vote locally before forwarding to chain
# (the contract re-verifies independently on-chain regardless).
ARBITER_PUBKEYS=
ARBITER_THRESHOLD=3
